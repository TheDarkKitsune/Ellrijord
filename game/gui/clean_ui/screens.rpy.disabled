## Preferences screen ##########################################################
##
## The preferences screen allows the player to configure the game to better suit
## themselves.
##
## https://www.renpy.org/doc/html/screen_special.html#preferences

screen preferences():
    tag menu
    use game_menu(_("Settings"), scroll="viewport"):

        vbox spacing (4 * gui.pref_spacing):
            hbox:
                box_wrap True
                if renpy.variant("pc") or renpy.variant("web"):

                    vbox:
                        style_prefix "radio"
                        label _("Display")
                        textbutton _("Window") action Preference("display", "window")
                        textbutton _("Fullscreen") action Preference("display", "fullscreen")

                vbox:
                    style_prefix "check"
                    label _("Skip")
                    textbutton _("Unseen Text") action Preference("skip", "toggle")
                    textbutton _("After Choices") action Preference("after choices", "toggle")
                    textbutton _("Transitions") action InvertSelected(Preference("transitions", "toggle"))

                vbox:
                    style_prefix "radio"
                    label _("UI Theme")
                    viewport xsize 250 ysize 200:
                        mousewheel True
                        draggable True
                        scrollbars "vertical"
                        vbox xsize 200:
                            textbutton _("Default") action SetVariable("persistent.color_theme", "default"), Function(gui.rebuild) text_color "#fff" text_outlines []
                            textbutton _("Red") action SetVariable("persistent.color_theme", "red"), Function(gui.rebuild) text_color "#ff9898" text_outlines []
                            textbutton _("Orange") action SetVariable("persistent.color_theme", "orange"), Function(gui.rebuild) text_color "#ffcb7d" text_outlines []
                            textbutton _("Yellow") action SetVariable("persistent.color_theme", "yellow"), Function(gui.rebuild) text_color "#fff67c" text_outlines []
                            textbutton _("Green") action SetVariable("persistent.color_theme", "green"), Function(gui.rebuild) text_color "#94ff94" text_outlines []
                            textbutton _("Cyan") action SetVariable("persistent.color_theme", "cyan"), Function(gui.rebuild) text_color "#91fff6" text_outlines []
                            textbutton _("Blue") action SetVariable("persistent.color_theme", "blue"), Function(gui.rebuild) text_color "#91bdff" text_outlines []
                            textbutton _("Purple") action SetVariable("persistent.color_theme", "purple"), Function(gui.rebuild) text_color "#caa5ff" text_outlines []
                            textbutton _("Pink") action SetVariable("persistent.color_theme", "pink"), Function(gui.rebuild) text_color "#ffc0f7" text_outlines []

                ## Additional vboxes of type "radio_pref" or "check_pref" can be
                ## added here, to add additional creator-defined preferences.

            hbox:
                # box_wrap True

                style_prefix "slider"

                vbox xsize 500:
                    label _("Text Speed")
                    bar value Preference("text speed")
                    label _("Auto-Forward Time")
                    bar value Preference("auto-forward time")

                    vbox:
                        null height 40
                        style_prefix "radio"
                        label _("Cursor Size")
                        textbutton _("Small") action SetVariable("persistent.cursor_size", "small"), Function(renpy.notify, _("Changes will take effect after restart."))
                        textbutton _("Large") action SetVariable("persistent.cursor_size", "large"), Function(renpy.notify, _("Changes will take effect after restart."))

                vbox xsize 500:

                    vbox:
                        if preferences.get_mute('main'):
                            at transform:
                                linear 0.5 alpha 0.6
                        else:
                            at transform:
                                linear 0.5 alpha 1.0

                        label _("Volume - All")
                        hbox spacing 20:
                            bar value Preference("main volume")
                            text "{}%".format(int(preferences.get_mixer('main')*100))

                        if config.has_music:
                            label _("Volume - Music")
                            hbox spacing 20:
                                bar value Preference("music volume")
                                text "{}%".format(int(preferences.get_mixer('music')*100))

                        if config.has_sound:
                            label _("Volume - Sound")
                            hbox spacing 20:
                                bar value Preference("sound volume")
                                text "{}%".format(int(preferences.get_mixer('sfx')*100))
                                # if config.sample_sound:
                                #     textbutton _("Test") action Play("sound", config.sample_sound)

                        if config.has_voice:
                            label _("Volume - Voice")
                            hbox spacing 20:
                                bar value Preference("voice volume")
                                text "{}%".format(int(preferences.get_mixer('voice')*100))
                                # if config.sample_voice:
                                #     textbutton _("Test") action Play("voice", config.sample_voice)

                    if config.has_music or config.has_sound or config.has_voice:
                        null height gui.pref_spacing
                        textbutton _("Mute All"):
                            action Preference("all mute", "toggle")
                            style "mute_all_button"

