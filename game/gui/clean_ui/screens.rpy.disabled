## Say screen ##################################################################
##
## The say screen is used to display dialogue to the player. It takes two
## parameters, who and what, which are the name of the speaking character and
## the text to be displayed, respectively. (The who parameter can be None if no
## name is given.)
##
## This screen must create a text displayable with id "what", as Ren'Py uses
## this to manage text display. It can also create displayables with id "who"
## and id "window" to apply style properties.
##
## https://www.renpy.org/doc/html/screen_special.html#say

screen say(who, what):

    frame xalign 0.5:
        style "window"

        if HasSideImage():
            fixed fit_first True:
                xanchor 0.0 xpos 0.33
                vbox spacing 10:
                    null height 10
                    if who is not None:
                        hbox spacing 10 xanchor 0.0 xpos 0.0:
                            add "gui/namebox_left.png" yalign 0.5:
                                at gui_theme_colorize
                            text who id "who" style "namebox"
                            add "gui/namebox_right.png" yalign 0.5:
                                at gui_theme_colorize
                    text what id "what":
                        xmaximum 1000
                        text_align 0.0
                        yanchor 0.0 ypos 0
                if not renpy.variant("small"):
                    fixed fit_first True:
                        xanchor 1.0 xpos -30 ypos 20
                        add "gui/side_image_base.png"
                        add SideImage()
                        add "gui/side_image_frame.png" at gui_theme_colorize
        
        else:
            vbox spacing 20:
                xalign 0.5
                if who is not None:
                    frame:
                        style "namebox"
                        hbox spacing 15 xanchor 0.0 xpos 0.0:
                            add Transform("gui/namebox_right.png", xzoom=-1) yalign 0.5:
                                at gui_theme_colorize
                            text who id "who"
                            add "gui/namebox_right.png" yalign 0.5:
                                at gui_theme_colorize
                else:
                    null height 10
                text what id "what"


## Make the namebox available for styling through the Character object.
init python:
    config.character_id_prefixes.append('namebox')

style window is default
style say_label is default
style say_dialogue is default
