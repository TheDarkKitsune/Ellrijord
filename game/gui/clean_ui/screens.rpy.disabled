    yalign 1.0
    xsize 1.0
    yminimum gui.textbox_height
    top_padding 25
    bottom_padding 70
    background Frame(At("gui/textbox.png", gui_theme_colorize), left=0, right=0, top=100, bottom=60)
style namebox:
    xpos gui.name_xpos
    xanchor gui.name_xalign
    xsize gui.namebox_width
    ypos gui.name_ypos
    ysize gui.namebox_height
    padding gui.namebox_borders.padding
    background None
style say_label:
    properties gui.text_properties("name", accent=True)
    xalign gui.name_xalign
    yalign 0.5
    bold True
style say_dialogue:
    properties gui.text_properties("dialogue")

    xpos gui.dialogue_xpos
    xsize gui.dialogue_width
    yanchor 1.0
    ypos gui.dialogue_ypos

    adjust_spacing False


screen ctc(arg=None):
    zorder 100
    add "gui/ctc.png":
        at ctc_appear, gui_theme_colorize
        xalign .5
        yalign .97
transform ctc_appear:
    parallel:
        alpha 0.0
        linear 0.3 alpha 1.0
    parallel:
        yoffset 0
        ease 0.5 yoffset 10
        pause 0.1
        ease 0.1 yoffset 0
        repeat


## Input screen ################################################################
##
## This screen is used to display renpy.input. The prompt parameter is used to
## pass a text prompt in.
##
## This screen must create an input displayable with id "input" to accept the
## various input parameters.
##
## https://www.renpy.org/doc/html/screen_special.html#input

screen input(prompt):
    style_prefix "input"

    window:

        vbox:
            xanchor gui.dialogue_text_xalign
            xpos gui.dialogue_xpos
            xsize gui.dialogue_width
            ypos gui.dialogue_ypos

            text prompt style "input_prompt"
            input id "input"

style input_prompt is default
style input_prompt:
    xalign gui.dialogue_text_xalign
    properties gui.text_properties("input_prompt")
style input:
    xalign gui.dialogue_text_xalign
    xmaximum gui.dialogue_width



## Choice screen ###############################################################
##
## This screen is used to display the in-game choices presented by the menu
## statement. The one parameter, items, is a list of objects, each with caption
## and action fields.
##
## https://www.renpy.org/doc/html/screen_special.html#choice

screen choice(items):
    style_prefix "choice"

    frame:
        xalign 0.5 yalign 0.45
        background None
        vbox:
            for i in items:
                textbutton i.caption action i.action

style choice_vbox is vbox
style choice_button is button
style choice_button_text is button_text
style choice_vbox:
    xalign 0.5
    yalign 0.5
    spacing gui.choice_spacing
style choice_button is default:
    properties gui.button_properties("choice_button")
    xsize 910 ysize 70

    background At(Frame("gui/button/choice_idle_background.png", 35,35), gui_theme_colorize)
    hover_background At(Frame("gui/button/choice_hover_background.png", 35,35), gui_theme_colorize)
    selected_background At(Frame("gui/button/choice_selected_idle_background.png", 35,35), gui_theme_colorize)
    insensitive_background Frame("gui/button/choice_insensitive_background.png", 35,35)

    hover_sound "audio/button_hover.ogg"
    activate_sound "audio/button_click.ogg"
style choice_button_text is default:
    properties gui.text_properties("choice_button")
    yalign .5 text_align .5



## Quick Menu screen ###########################################################
##
## The quick menu is displayed in-game to provide easy access to the out-of-game
## menus.

transform quick_menu_atl:
    zoom 0.2
screen quick_menu():

    ## Ensure this appears on top of other screens.
    zorder 100

    default tab = None

    if quick_menu:

        add "gui/quickmenu_ui.png" yalign 1.0

        vbox:
            anchor(1.0,1.0) pos(0.99,0.99)

            if tab:
                text tab xalign 1.0:
                    style "quickmenu_text"
                    at transform:
                        alpha 0 xoffset 60
                        ease 0.2 alpha 1 xoffset 0

            # Add a space to fit the skipping indicator
            if renpy.is_skipping():
                null height 60

            hbox spacing 0 xalign 1.0:
                style_prefix "quick"
                style "quick_menu"
                imagebutton auto "gui/buttons_navigation/history_%s.png":
                    at quick_menu_atl, gui_theme_colorize
                    hovered SetLocalVariable('tab', _("History"))
                    unhovered SetLocalVariable('tab', None)
                    action ShowMenu('history')
                imagebutton auto "gui/buttons_navigation/return_%s.png":
                    at quick_menu_atl, gui_theme_colorize
                    hovered SetLocalVariable('tab', _("Back"))
                    unhovered SetLocalVariable('tab', None)
                    action Rollback()
                imagebutton auto "gui/buttons_navigation/skip_%s.png":
                    at quick_menu_atl, gui_theme_colorize
                    hovered SetLocalVariable('tab', _("Skip"))
                    unhovered SetLocalVariable('tab', None)
                    action Skip() alternate Skip(fast=True, confirm=True)
                    if not renpy.is_skipping():
                        activate_sound "audio/skip.ogg"
                imagebutton auto "gui/buttons_navigation/auto_%s.png":
                    at quick_menu_atl, gui_theme_colorize
                    hovered SetLocalVariable('tab', _("Auto Forward"))
                    unhovered SetLocalVariable('tab', None)
                    action Preference("auto-forward", "toggle")
                imagebutton auto "gui/buttons_navigation/save_%s.png":
                    at quick_menu_atl, gui_theme_colorize
                    hovered SetLocalVariable('tab', _("Save"))
                    unhovered SetLocalVariable('tab', None)
                    action ShowMenu('save')
                imagebutton auto "gui/buttons_navigation/qsave_%s.png":
                    at quick_menu_atl, gui_theme_colorize
                    hovered SetLocalVariable('tab', _("Quick Save"))
                    unhovered SetLocalVariable('tab', None)
                    action QuickSave()
                imagebutton auto "gui/buttons_navigation/load_%s.png":
                    at quick_menu_atl, gui_theme_colorize
                    hovered SetLocalVariable('tab', _("Quick Load"))
                    unhovered SetLocalVariable('tab', None)
                    action QuickLoad()
                imagebutton auto "gui/buttons_navigation/settings_%s.png":
                    at quick_menu_atl, gui_theme_colorize
                    hovered SetLocalVariable('tab', _("Settings"))
                    unhovered SetLocalVariable('tab', None)
                    action ShowMenu('preferences')

## This code ensures that the quick_menu screen is displayed in-game, whenever
## the player has not explicitly hidden the interface.
init python:
    config.overlay_screens.append("quick_menu")

default quick_menu = True

style quick_menu is hbox
