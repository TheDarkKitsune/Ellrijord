## Navigation screen ###########################################################
##
## This screen is included in the main and game menus, and provides navigation
## to other menus, and to start the game.

transform custom_navigation_button:
    anchor(.5,.5) pos(0,.5) xoffset 150
    on idle:
        ease .2 zoom 0.8
    on hover:
        ease .3 zoom 1.0
transform custom_navigation_gallery_button:
    anchor(.5,.5) pos(1.0,.5) xoffset -150
    on idle:
        ease .2 zoom 0.8
    on hover:
        ease .3 zoom 1.0
transform custom_navigation_return_button:
    anchor(.5,.5)
    on idle:
        ease .2 zoom 0.7
    on hover:
        ease .3 zoom 0.8
style custom_navigation_text:
    yalign 0.5 xpos 0 xoffset 240
    outlines [(1, color_theme[persistent.color_theme]['outlines_color'], 3, 3)]
style custom_navigation_gallery_text:
    take custom_navigation_text
    xpos 1.0 xoffset -340 text_align 1.0
    outlines [(1, color_theme[persistent.color_theme]['outlines_color'], 3, 3)]

screen navigation():
    style_prefix "custom_navigation"

    add "gui/navigation_ui.png" at gui_theme_colorize

    # START Button
    if main_menu:
        fixed fit_first True:
            align(.13,.05)
            add "gui/button_text_frame.png"
            text _("New Game")
            imagebutton auto "gui/buttons_navigation/start_%s.png".format(persistent.color_theme):
                at custom_navigation_button, gui_theme_colorize
                action Start()

    # HISTORY Button
    else:
        fixed fit_first True:
            align(.13,.05)
            add "gui/button_text_frame.png"
            text _("History"):
                if renpy.get_screen('history'):
                    at gui_theme_colorize, Transform(xalign=0.0, zoom=1.2)
            imagebutton auto "gui/buttons_navigation/history_%s.png".format(persistent.color_theme):
                at custom_navigation_button, gui_theme_colorize
                action ShowMenu("history")
    
    # SAVE Button
    if not main_menu:
        fixed fit_first True:
            align(.1,.23)
            add "gui/button_text_frame.png"
            text _("Save"):
                if renpy.get_screen('save'):
                    at gui_theme_colorize, Transform(xalign=0.0, zoom=1.2)
            imagebutton auto "gui/buttons_navigation/save_%s.png".format(persistent.color_theme):
                at custom_navigation_button, gui_theme_colorize
                action ShowMenu("save")

    # LOAD Button
    fixed fit_first True:
        if main_menu:
            align(.1,.23)
        else:
            align(.09,.41)
        add "gui/button_text_frame.png"
        text _("Load"):
            if renpy.get_screen('load'):
                at gui_theme_colorize, Transform(xalign=0.0, zoom=1.2)
        imagebutton auto "gui/buttons_navigation/load_%s.png".format(persistent.color_theme):
            at custom_navigation_button, gui_theme_colorize
            action ShowMenu("load")

    # ABOUT Button
    if main_menu:
        fixed fit_first True:
            if main_menu:
                align(.09,.41)
            else:
                align(.13,.05)
            add "gui/button_text_frame.png"
            text _("About"):
                if renpy.get_screen('about'):
                    at gui_theme_colorize, Transform(xalign=0.0, zoom=1.2)
            imagebutton auto "gui/buttons_navigation/about_%s.png".format(persistent.color_theme):
                at custom_navigation_button, gui_theme_colorize
                action ShowMenu("about")

    # SETTINGS Button
    fixed fit_first True:
        align(.09,.59)
        add "gui/button_text_frame.png"
        text _("Settings"):
            if renpy.get_screen('preferences'):
                at gui_theme_colorize, Transform(xalign=0.0, zoom=1.2)
        imagebutton auto "gui/buttons_navigation/settings_%s.png".format(persistent.color_theme):
            at custom_navigation_button, gui_theme_colorize
            action ShowMenu("preferences")

    # HELP Button
    if renpy.variant("pc") or (renpy.variant("web") and not renpy.variant("mobile")):
        fixed fit_first True:
            align(.1,.77)
            add "gui/button_text_frame.png"
            text _("Help"):
                if renpy.get_screen('help'):
                    at gui_theme_colorize, Transform(xalign=0.0, zoom=1.2)
            imagebutton auto "gui/buttons_navigation/help_%s.png".format(persistent.color_theme):
                at custom_navigation_button, gui_theme_colorize
                action ShowMenu("help")

    # QUIT Button
    if main_menu and renpy.variant("pc"):
        fixed fit_first True:
            align(.13,.95)
            add "gui/button_text_frame.png"
            text _("Quit")
            imagebutton auto "gui/buttons_navigation/quit_%s.png".format(persistent.color_theme):
                at custom_navigation_button, gui_theme_colorize
                action Quit(confirm=not main_menu)

    # END REPLAY Button
    elif _in_replay:
        fixed fit_first True:
            align(.13,.95)
            add "gui/button_text_frame.png"
            text _("End Replay")
            imagebutton auto "gui/buttons_navigation/quit_%s.png".format(persistent.color_theme):
                at custom_navigation_button, gui_theme_colorize
                action EndReplay(confirm=True)

    # MAIN MENU Button
    elif not main_menu:
        fixed fit_first True:
            align(.13,.95)
            add "gui/button_text_frame.png"
            text _("Main Menu")
            imagebutton auto "gui/buttons_navigation/quit_%s.png".format(persistent.color_theme):
                at custom_navigation_button, gui_theme_colorize
                action MainMenu()

screen navigation_gallery():
    style_prefix "custom_navigation_gallery"

    add "gui/navigation_ui_gallery.png" at gui_theme_colorize

    # MUSIC Button
    fixed fit_first True:
        align(1.03,0.90)
        add Transform("gui/button_text_frame.png", xzoom=-1)
        text _("Music")
        imagebutton auto "gui/buttons_navigation/music_%s.png".format(persistent.color_theme):
            at custom_navigation_gallery_button, gui_theme_colorize
            action ShowMenu("music")

    # GALLERY Button
    fixed fit_first True:
        align(.95,1.03)
        add Transform("gui/button_text_frame.png", xzoom=-1)
        text _("Gallery")
        imagebutton auto "gui/buttons_navigation/gallery_%s.png".format(persistent.color_theme):
            at custom_navigation_gallery_button, gui_theme_colorize
            action ShowMenu("gallery")
    

style navigation_button is gui_button
style navigation_button_text is gui_button_text
style navigation_button:
    size_group "navigation"
    properties gui.button_properties("navigation_button")
style navigation_button_text:
    properties gui.text_properties("navigation_button")



## Main Menu screen ############################################################
##
## Used to display the main menu when Ren'Py starts.
##
## https://www.renpy.org/doc/html/screen_special.html#main-menu

# PARALLAX effect
transform parallax_effect(paramod=50):
    zoom 1.02 align(.5,.5)
    function partial(track_mouse, paramod=paramod)
init python:
    from functools import partial
    def track_mouse(trans, st, at, paramod=20):
        mx, my = renpy.get_mouse_pos()
        x_offset = (mx - config.screen_width/2) / paramod
        y_offset = (my - config.screen_height/2) / paramod
        trans.xoffset = -x_offset
        trans.yoffset = -y_offset
        return 0.0

screen main_menu():

    ## This ensures that any other menu screen is replaced.
    tag menu

    add gui.main_menu_background at parallax_effect

    ## The use statement includes another screen inside this one. The actual
    ## contents of the main menu are in the navigation screen.
    use navigation
    use navigation_gallery

    if gui.show_name:

        vbox align(0.95,0.05):
            text "[config.name!t]":
                style "main_menu_title"
            text "[config.version]":
                style "main_menu_version"

style main_menu_frame is empty
style main_menu_vbox is vbox
style main_menu_text is gui_text
style main_menu_title is main_menu_text
style main_menu_version is main_menu_text
style main_menu_vbox:
    xalign 1.0
    xoffset -30
    xmaximum 1200
    yalign 1.0
    yoffset -30
style main_menu_text:
    properties gui.text_properties("main_menu", accent=True)
    outlines [(1, color_theme[persistent.color_theme]['outlines_color'], 3, 3)]
style main_menu_title:
    properties gui.text_properties("title")
style main_menu_version:
    properties gui.text_properties("version")



## Game Menu screen ############################################################
##
## This lays out the basic common structure of a game menu screen. It's called
## with the screen title, and displays the background, title, and navigation.
##
## The scroll parameter can be None, or one of "viewport" or "vpgrid".
## This screen is intended to be used with one or more children, which are
## transcluded (placed) inside it.

screen game_menu(title, scroll=None, yinitial=0.0, spacing=0):

    style_prefix "game_menu"

    if main_menu:
        add gui.main_menu_background
    else:
        add gui.game_menu_background
    add "gui/overlay/game_menu.png"

    frame:
        style "game_menu_outer_frame"
        xpos 750 yalign 0.7
        xsize 1150 ysize 1000
        
        hbox:
            
            if scroll == "viewport":

                viewport:
                    yinitial yinitial
                    scrollbars "vertical"
                    mousewheel True
                    # draggable True
                    pagekeys True
                    side_yfill True

                    vbox:
                        spacing spacing

                        transclude

            elif scroll == "vpgrid":

                vpgrid:
                    cols 1
                    yinitial yinitial

                    scrollbars "vertical"
                    mousewheel True
                    # draggable True
                    pagekeys True

                    side_yfill True

                    spacing spacing

                    transclude

            else:

                transclude

    use navigation

    # RETURN Button
    imagebutton auto "gui/buttons_navigation/return_%s.png":
        at custom_navigation_return_button, gui_theme_colorize
        pos(0.06,.5)
        action Return()

    add "gui/game_menu_label.png" at gui_theme_colorize
    label title xanchor 1.0 xpos 0.97:
        text_outlines [(4, '#000', 4, 4), (1, color_theme[persistent.color_theme]['interface_text_color'], -1, -1)]

    if main_menu:
        key "game_menu" action ShowMenu("main_menu")

